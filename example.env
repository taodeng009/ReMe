# LLM (required for most flows)
LLM_API_KEY=sk-xxxx
LLM_BASE_URL=https://xxxx/v1
LLM_MODEL_NAME=xxxx
LLM_BACKEND=XXX
#EMBEDDING_API_KEY=sk-xxxx
#EMBEDDING_BASE_URL=https://xxxx/v1

# HiAgent integration: phase-A persistent fixed pool
# Use an absolute directory and keep the same path across service restarts.
REME_HIAGENT_VECTOR_STORE_BACKEND=local
REME_HIAGENT_VECTOR_STORE_PATH=/absolute/path/to/reme-hiagent-vector-store
REME_HIAGENT_WORKSPACE_ID=alfworld-phase1
# Build with read_write, then freeze experiments with read_only.
REME_HIAGENT_WORKSPACE_MODE=read_write
# Keep ledger and vector-store state under the same stable experiment run.
REME_HIAGENT_RUN_ID=alfworld-phase1
